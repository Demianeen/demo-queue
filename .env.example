# Local development uses the deployment selected by Convex.
# Production receives this URL from `convex deploy`; Preview uses canonical Dev.
CONVEX_DEPLOYMENT=dev:precious-elk-564
NEXT_PUBLIC_CONVEX_URL=https://precious-elk-564.convex.cloud

# Optional. Used only by queue helper output when printing full admin URLs.
# Locally this defaults to http://localhost:3000. Production defaults to the
# stable Vercel alias when using `pnpm queue:prod`.
DEMO_QUEUE_SITE_URL=http://localhost:3000

# Native Google Sheet export runs inside Convex. Configure these with
# `pnpm exec convex env set`, not in this local Next.js env file:
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET
# GOOGLE_OAUTH_REFRESH_TOKEN
# GOOGLE_DRIVE_FOLDER_ID (folder in the connected account's My Drive)

# Submission emails (confirmation and "email me the link again") are sent by
# Convex through Resend. Set all three on the Convex deployment; without them
# sending is skipped and logged:
# RESEND_API_KEY
# RESEND_FROM_EMAIL (an address on a domain verified in Resend)
# DEMO_QUEUE_SITE_URL (the public site, used to build status links)

# WorkOS AuthKit server credentials for this development environment.
# These must match WORKOS_CLIENT_ID configured on the Convex deployment.
WORKOS_CLIENT_ID=<development-client-id>
WORKOS_API_KEY=<development-api-key>
WORKOS_COOKIE_PASSWORD=<random-secret-at-least-32-characters>
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# MCP component runs in Convex and retains WorkOS for identity/membership checks.
# Production issuer and consent are fixed to https://hack.outpostcrew.co.
# Development consent defaults to http://localhost:3002/events/connect.
# Optional Dev backend override: MCP_CONSENT_URL=https://<frontend>/events/connect
# Configure backend variables on the matching Convex deployment, not here.
# The registered component endpoint does not use WORKOS_MCP_ISSUER or WORKOS_MCP_RESOURCE.

# PostHog (EU Cloud). Without the token, PostHog is not loaded. Local runs and
# Preview use the "Demo queue dev" project's token; Production uses "Demo queue".
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=<phc_ project token>
# Source maps are uploaded at build time only when both are set (Vercel only):
# POSTHOG_PERSONAL_API_KEY (error tracking write)
# POSTHOG_PROJECT_ID
