# Local development uses the deployment selected by Convex.
# Vercel production and preview builds receive this value from `convex deploy`.
CONVEX_DEPLOYMENT=dev:precious-elk-564
NEXT_PUBLIC_CONVEX_URL=https://precious-elk-564.convex.cloud

# Optional. Used only by queue helper output when printing full admin URLs.
# Locally this defaults to http://localhost:3000. Production defaults to the
# stable Vercel alias when using `pnpm queue:prod`.
DEMO_QUEUE_SITE_URL=http://localhost:3000

# Native Google Sheet export runs inside Convex. Configure these with
# `pnpm exec convex env set`, not in this local Next.js env file:
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET
# GOOGLE_OAUTH_REFRESH_TOKEN
# GOOGLE_DRIVE_FOLDER_ID (folder in the connected account's My Drive)

# WorkOS AuthKit server credentials for this development environment.
# These must match WORKOS_CLIENT_ID configured on the Convex deployment.
WORKOS_CLIENT_ID=<development-client-id>
WORKOS_API_KEY=<development-api-key>
WORKOS_COOKIE_PASSWORD=<random-secret-at-least-32-characters>
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# MCP runs in Convex, not Next.js. Configure these on the matching backend only:
# WORKOS_MCP_ISSUER=https://<this-environment-authkit-domain>
# WORKOS_MCP_RESOURCE=https://precious-elk-564.convex.site/mcp
# If the resource is omitted, it derives from Convex's built-in CONVEX_SITE_URL.
# The backend also needs its existing WORKOS_API_KEY for active membership checks.
